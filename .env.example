# --- Core ---
UX_KB_CONTENT_DIR=

# Auth/usage persistence: "db" (Postgres) or "memory" (process-local, dev only).
KB_STORE=

# --- MCP server (stdio / local HTTP) ---
MCP_TRANSPORT=stdio
MCP_PORT=3333
MCP_HOST=127.0.0.1
LOG_LEVEL=info
ADMIN_ORIGIN=
# In-flight request cap per serverless instance.
MCP_MAX_CONCURRENCY=32

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ux_kb?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/ux_kb?schema=public

# --- API keys ---
# HMAC key for API-key hashes and IP hashing. Rotating it invalidates every
# existing key, so issue replacements first.
KEY_HASH_SECRET=

# Local HTTP development only
MCP_DEV_KEY=
MCP_DEV_KEY_RATE_LIMIT=120

# --- Web / Auth.js ---
# openssl rand -base64 32
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Production origin, e.g. https://ux-kb-site.vercel.app
AUTH_URL=
NEXTAUTH_URL=http://localhost:3000
# Comma-separated GitHub logins that become ADMIN. Everyone else is a MEMBER.
ALLOWED_GITHUB_LOGINS=

# --- Cron ---
# Vercel sends "Authorization: Bearer $CRON_SECRET" to /api/cron/cleanup.
CRON_SECRET=
