{
  "name": "@ux-kb/stdio",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=../../.env --watch --import tsx src/index.ts",
    "dev:http": "node --env-file=../../.env --watch --import tsx src/index.ts --http",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "build": "tsup",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:http": "tsx scripts/http-smoke.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@prisma/client": "6.19.3",
    "@ux-kb/core": "workspace:*",
    "@ux-kb/mcp": "workspace:*",
    "express": "^5.3.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3"
  }
}
