{
  "id": "CMP-006",
  "title": "Navigation Bars",
  "rev": 2,
  "etag": "sha256:d3bb9d3064b35f4299517821766004e12e886170b0918fca1de78c4fa5afc53d",
  "status": "reviewed",
  "domain": "components",
  "tags": [
    "navigation-bars",
    "components"
  ],
  "appliesTo": [
    "web",
    "mobile"
  ],
  "summary": "Navigation expresses information architecture and current location.",
  "sections": {
    "MUST": [
      {
        "id": "CMP-006.M1",
        "text": "Use user vocabulary and group destinations by task."
      },
      {
        "id": "CMP-006.M2",
        "text": "Use a `<nav>` landmark with an accessible name and provide a skip link to main content (SC 2.4.1)."
      },
      {
        "id": "CMP-006.M3",
        "text": "Indicate current location with `aria-current=\"page\"` (or equivalent) in addition to color."
      }
    ],
    "SHOULD": [
      {
        "id": "CMP-006.S1",
        "text": "Indicate current location beyond color alone (weight, underline or icon)."
      },
      {
        "id": "CMP-006.S2",
        "text": "Keep primary nav concise; move secondary destinations to menus or footer."
      }
    ],
    "AVOID": [
      {
        "id": "CMP-006.A1",
        "text": "Do not overload primary navigation or use ambiguous labels."
      },
      {
        "id": "CMP-006.A2",
        "text": "Do not rely on color alone for current location."
      }
    ],
    "DECIDE": [
      {
        "situation": "Top-level destinations",
        "decision": "Primary nav landmark"
      },
      {
        "situation": "Current page",
        "decision": "aria-current + visual marker"
      },
      {
        "situation": "Skip to content",
        "decision": "Skip link before nav"
      },
      {
        "situation": "Mobile",
        "decision": "Collapsible menu with focus management"
      }
    ],
    "STATES": [
      "Default",
      "Hover",
      "Focus",
      "Current",
      "Collapsed (mobile)",
      "Sticky",
      "Error",
      "Responsive"
    ],
    "EXAMPLE": {
      "good": "`<nav aria-label=\"Primary\">` with “Overview, Transactions, Reports, Settings”; current item has `aria-current=\"page\"` and an underline",
      "bad": "all report links in the top nav with color-only current state"
    },
    "FAILURE_MODES": [
      "Missing landmark/skip link forces keyboard users through repeated nav.",
      "Color-only current location is invisible to some users.",
      "Overloaded nav increases decision time (Hick)."
    ],
    "CHECK": []
  },
