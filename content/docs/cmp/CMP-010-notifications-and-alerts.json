{
  "id": "CMP-010",
  "title": "Notifications and Alerts",
  "rev": 2,
  "etag": "sha256:251f87e9b80c2ab88bf5b62f2e20beb50f254fb5c9326d60964de16d72e1d3f0",
  "status": "reviewed",
  "domain": "components",
  "tags": [
    "notifications-and-alerts",
    "components"
  ],
  "appliesTo": [
    "web",
    "mobile"
  ],
  "summary": "Notifications communicate state changes at appropriate urgency and persistence.",
  "sections": {
    "MUST": [
      {
        "id": "CMP-010.M1",
        "text": "Match urgency to presentation: inline status, page banner or alert dialog; announce asynchronous updates (WCAG 4.1.3)."
      },
      {
        "id": "CMP-010.M2",
        "text": "Use `role=\"status\"` for non-urgent updates and `role=\"alert\"` (or an alert dialog) for urgent interruptions."
      },
      {
        "id": "CMP-010.M3",
        "text": "Provide text plus icon/color and an actionable next step; do not rely on color alone."
      }
    ],
    "SHOULD": [
      {
        "id": "CMP-010.S1",
        "text": "Use text plus icon/color and give actionable next steps."
      },
      {
        "id": "CMP-010.S2",
        "text": "Auto-dismiss only non-critical toasts; keep errors until dismissed."
      }
    ],
    "AVOID": [
      {
        "id": "CMP-010.A1",
        "text": "Do not stack transient toasts or rely on color alone."
      },
      {
        "id": "CMP-010.A2",
        "text": "Do not use alert dialogs for minor status updates."
      }
    ],
    "DECIDE": [
      {
        "situation": "Success/info",
        "decision": "role=\"status\" live region"
      },
      {
        "situation": "Error/urgent",
        "decision": "role=\"alert\" or alert dialog"
      },
      {
        "situation": "Blocking failure",
        "decision": "Modal alert dialog"
      },
      {
        "situation": "Transient toast",
        "decision": "Single, auto-dismiss, pausable"
      }
    ],
    "STATES": [
      "Idle",
      "Pending",
      "Success",
      "Warning",
      "Error",
      "Dismissed",
      "Responsive"
    ],
    "EXAMPLE": {
      "good": "“Changes saved” status region; payment failure includes a next step and retry",
      "bad": "“Error 500” toast, color-only, no action"
    },
    "FAILURE_MODES": [
      "Unannounced status changes are invisible to screen-reader users (WCAG 4.1.3).",
      "Stacked toasts overwhelm and obscure content.",
      "Color-only or vague messages fail recovery."
    ],
    "CHECK": []
  },
