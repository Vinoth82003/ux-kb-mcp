  "summary": "Choice time tends to increase with number and uncertainty of choices; reduce unnecessary decision complexity.",
  "sections": {
    "MUST": [
      {
        "id": "EVAL-004.M1",
        "text": "Group choices by user goal and reveal secondary options progressively."
      }
    ],
    "SHOULD": [
      {
        "id": "EVAL-004.S1",
        "text": "Keep comparable options visible when comparison matters."
      }
    ],
    "AVOID": [
      {
        "id": "EVAL-004.A1",
        "text": "Do not hide essential choices or assume fewer options always better."
      }
    ],
    "DECIDE": [
      {
        "situation": "Many low-value options",
        "decision": "Group/search/filter"
      },
      {
        "situation": "Comparison task",
        "decision": "Keep options visible"
      },
      {
        "situation": "Expert workflow",
        "decision": "Allow shortcuts and saved defaults"
      }
    ],
    "STATES": [
      "First choice",
      "Comparison",
      "Filtering",
      "Confirmation",
      "Repeat use"
    ],
    "EXAMPLE": {
      "good": "Plan choice uses comparison table; 300 integrations use search",
      "bad": "300 integrations in one dropdown"
    },
    "FAILURE_MODES": [
      "Fewer options can remove needed control; validate against task goals.",
      "Grouping by vendor instead of user goal increases scanning; test findability.",
      "Search hides options without good metadata; ensure keywords and empty states."
    ],
