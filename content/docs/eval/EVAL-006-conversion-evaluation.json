        "decision": "Stop on harm threshold"
      },
      {
        "situation": "Deceptive pattern temptation",
        "decision": "Reject; redesign value proposition"
      }
    ],
    "STATES": [
      "Landing",
      "Checkout",
      "Confirmation",
      "Post-purchase",
      "Cancellation/refund"
    ],
    "EXAMPLE": {
      "good": "Valid subscriptions / eligible checkout starts plus refund rate",
      "bad": "Counting all page views as conversions"
    },
    "FAILURE_MODES": [
      "Conversion lifts can come from coercion; audit copy and defaults.",
      "Guardrails lag; define stop rules before launch.",
      "Dark patterns may pass short-term metrics but increase refunds/support; track downstream."
