  "summary": "Conversion evaluation tests whether qualified users complete meaningful actions without dark patterns.",
  "sections": {
    "MUST": [
      {
        "id": "EVAL-006.M1",
        "text": "Define eligible population, conversion event, denominator, window and guardrails before analysis."
      }
    ],
    "SHOULD": [
      {
        "id": "EVAL-006.S1",
        "text": "Pair conversion with errors, refunds, cancellations or support burden."
      }
    ],
    "AVOID": [
      {
        "id": "EVAL-006.A1",
        "text": "Do not fabricate urgency, preselect add-ons or hide material terms."
      }
    ],
    "DECIDE": [
      {
        "situation": "Metric rises but guardrail falls",
        "decision": "Investigate before celebrating"
      },
