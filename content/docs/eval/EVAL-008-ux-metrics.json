  ],
  "appliesTo": [
    "web",
    "mobile"
  ],
  "summary": "UX metrics quantify task outcomes; select measures tied to user and business goals.",
  "sections": {
    "MUST": [
      {
        "id": "EVAL-008.M1",
        "text": "Define formula, population, event, period, segmentation and data quality."
      }
    ],
    "SHOULD": [
      {
        "id": "EVAL-008.S1",
        "text": "Combine effectiveness, efficiency and satisfaction; interpret qualitative evidence too."
      }
    ],
    "AVOID": [
      {
        "id": "EVAL-008.A1",
        "text": "Do not use page views or time-on-page alone as proof of value."
      }
    ],
    "DECIDE": [
      {
        "situation": "Metric definition unclear",
        "decision": "Pause reporting"
      },
      {
        "situation": "Proxy metric only",
        "decision": "Label as proxy and add guardrail"
      },
      {
        "situation": "Qualitative conflict",
        "decision": "Investigate before changing design"
      }
    ],
    "STATES": [
      "Baseline",
      "Experiment",
      "Segmentation",
      "Guardrail review",
      "Post-launch"
    ],
    "EXAMPLE": {
      "good": "Task success = unassisted completions / participants attempting task",
      "bad": "\"Engagement up 20%\" with no definition"
    },
    "FAILURE_MODES": [
      "Vanity metrics can mask task failure; pair with outcome metrics.",
      "Small samples create noise; state confidence and period.",
      "Metric gaming follows incentives; review guardrails regularly."
    ],
    "CHECK": []
  },
  "checks": [
