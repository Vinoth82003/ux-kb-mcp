  ],
  "summary": "Adaptive layouts switch patterns when a different arrangement is more usable than fluid resizing, while preserving task and content parity.",
  "sections": {
    "MUST": [
      {
        "id": "RSP-004.M1",
        "text": "Change pattern only when task constraints justify it."
      }
    ],
    "SHOULD": [
      {
        "id": "RSP-004.S1",
        "text": "Keep content order, naming and action semantics consistent."
      }
    ],
    "AVOID": [
      {
        "id": "RSP-004.A1",
        "text": "Do not remove data or change action meaning between variants."
      }
    ],
    "DECIDE": [
      {
        "situation": "Fluid layout works",
        "decision": "Keep fluid"
      },
      {
        "situation": "Pattern switch needed",
        "decision": "Document justification + parity"
      },
      {
        "situation": "Content parity risk",
        "decision": "Keep same labels/data"
      },
      {
        "situation": "Mobile constraint",
        "decision": "Preserve targets and labels"
      }
    ],
    "STATES": [
      "Desktop variant",
      "Mobile variant",
      "Transition point",
      "Degraded/empty",
      "Error",
      "Loading"
    ],
    "EXAMPLE": {
      "good": "\"Mobile record view keeps sort and all essential fields from desktop grid.\"",
      "bad": "\"Mobile drops the Delete action and renames Export to Download.\""
    },
    "FAILURE_MODES": [
      "Adaptive variants drift in labels and actions.",
      "Hidden data on mobile breaks task completion.",
      "Pattern switches without user expectation cause disorientation.",
      "Parity not documented; regressions slip."
    ],
    "CHECK": []
  },
