  "summary": "Analytics interfaces make metric definitions, filters, attribution and uncertainty inspectable.",
  "sections": {
    "MUST": [
      {
        "id": "SAAS-003.M1",
        "text": "Expose formulas/windows for non-obvious metrics."
      }
    ],
    "SHOULD": [
      {
        "id": "SAAS-003.S1",
        "text": "Distinguish zero, missing, delayed and unavailable data."
      }
    ],
    "AVOID": [
      {
        "id": "SAAS-003.A1",
        "text": "Do not imply causation from correlation or hide denominator changes."
      }
    ],
    "DECIDE": [
      {
        "situation": "Metric ambiguous",
        "decision": "Expose formula and window"
      },
      {
        "situation": "Zero vs missing",
        "decision": "Label explicitly"
      },
      {
        "situation": "Filter change",
        "decision": "Update cohort and denominator"
      }
    ],
    "STATES": [
      "First use",
      "Populated",
      "Filtered empty",
      "Missing data",
      "Stale",
      "Error"
    ],
    "EXAMPLE": {
      "good": "12% conversion states 120 of 1,000 eligible visitors",
      "bad": "12% conversion with no denominator or cohort"
    },
    "FAILURE_MODES": [
      "Correlation presented as causation misleads; label uncertainty.",
      "Missing data shown as zero distorts decisions; distinguish.",
      "Hidden denominator changes invalidate trends; expose cohort."
    ],
    "CHECK": []
  },
  "checks": [
