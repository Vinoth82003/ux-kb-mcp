  "appliesTo": [
    "web",
    "mobile"
  ],
  "summary": "Onboarding helps users reach first meaningful value while learning only what is needed next.",
  "sections": {
    "MUST": [
      {
        "id": "SAAS-004.M1",
        "text": "Define activation as user outcome, not tutorial completion."
      }
    ],
    "SHOULD": [
      {
        "id": "SAAS-004.S1",
        "text": "Ask only for information needed now; defer optional configuration."
      }
    ],
    "AVOID": [
      {
        "id": "SAAS-004.A1",
        "text": "Do not force tours before users can act."
      }
    ],
    "DECIDE": [
      {
        "situation": "User can act immediately",
        "decision": "Skip tour"
      },
      {
        "situation": "Optional info",
        "decision": "Defer"
      },
      {
        "situation": "Activation unclear",
        "decision": "Define outcome metric"
      }
    ],
    "STATES": [
      "First run",
      "In progress",
      "Activated",
      "Skipped",
      "Error",
      "Returning"
    ],
    "EXAMPLE": {
      "good": "Import one project and show a useful result before asking for every preference",
      "bad": "8-step tour before any action"
    },
    "FAILURE_MODES": [
      "Tours block action; let users act first.",
      "Activation defined as completion inflates success; define outcome.",
      "Excessive upfront data increases drop-off; defer optional."
    ],
    "CHECK": []
  },
