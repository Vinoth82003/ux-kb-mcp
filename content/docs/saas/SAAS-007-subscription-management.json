  "appliesTo": [
    "web",
    "mobile"
  ],
  "summary": "Subscription management clarifies entitlement, renewal, changes and cancellation.",
  "sections": {
    "MUST": [
      {
        "id": "SAAS-007.M1",
        "text": "Show current plan, billing period, next renewal and usage."
      }
    ],
    "SHOULD": [
      {
        "id": "SAAS-007.S1",
        "text": "Explain effective date and access/data impact of changes."
      }
    ],
    "AVOID": [
      {
        "id": "SAAS-007.A1",
        "text": "Do not hide cancellation behind unrelated offers."
      }
    ],
    "DECIDE": [
      {
        "situation": "Plan change",
        "decision": "State effective date and access"
      },
      {
        "situation": "Cancellation",
        "decision": "Make discoverable, no dark pattern"
      },
      {
        "situation": "Renewal",
        "decision": "Notify before charge"
      }
    ],
    "STATES": [
      "Active",
      "Trial",
      "Past due",
      "Cancelled",
      "Expired",
      "Error"
    ],
    "EXAMPLE": {
      "good": "Cancel at period end on 30 June; access remains until then",
      "bad": "Cancel button hidden in settings submenu"
    },
    "FAILURE_MODES": [
      "Hidden cancellation traps users; make discoverable.",
      "Ambiguous effective dates cause disputes; state exact date.",
      "Usage/entitlement unclear; show current plan and usage."
    ],
    "CHECK": []
  },
  "checks": [
