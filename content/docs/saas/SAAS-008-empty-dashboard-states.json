  "tags": [
    "empty-dashboard-states",
    "saas"
  ],
  "appliesTo": [
    "web",
    "mobile"
  ],
  "summary": "An empty dashboard distinguishes setup incomplete, no activity, no permission and unavailable data.",
  "sections": {
    "MUST": [
      {
        "id": "SAAS-008.M1",
        "text": "State the real reason and the next action that resolves it."
      }
    ],
    "SHOULD": [
      {
        "id": "SAAS-008.S1",
        "text": "Clearly label demo data and isolate it from production metrics."
      }
    ],
    "AVOID": [
      {
        "id": "SAAS-008.A1",
        "text": "Do not show blank charts, fake zeros or misleading summaries."
      }
    ],
    "DECIDE": [
      {
        "situation": "Setup incomplete",
        "decision": "Show minimum next step"
      },
      {
        "situation": "No permission",
        "decision": "Explain and request access"
      },
      {
        "situation": "Demo data",
        "decision": "Label and isolate"
      }
    ],
    "STATES": [
      "Setup incomplete",
      "No activity",
      "Filtered empty",
      "No permission",
      "Unavailable",
      "Error"
    ],
    "EXAMPLE": {
      "good": "\"No invoices yet — create your first\" with a Create action",
      "bad": "Blank chart reading 0 with no reason or action"
    },
    "FAILURE_MODES": [
      "Blank charts imply zero; state the reason.",
      "Fake zeros mislead; distinguish missing/unavailable.",
      "Demo data mixed with production; label and isolate."
    ],
    "CHECK": []
  },
  "checks": [
    {
      "id": "SAAS-008.c1",
      "text": "Reason accurate?",
