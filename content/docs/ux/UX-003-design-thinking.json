  "summary": "Design thinking is iterative problem-framing and experimentation; its purpose is reducing uncertainty, not completing a ceremonial sequence.",
  "sections": {
    "MUST": [
      {
        "id": "UX-003.M1",
        "text": "Frame the problem as a user outcome."
      },
      {
        "id": "UX-003.M2",
        "text": "Generate materially different concepts before selection."
      },
      {
        "id": "UX-003.M3",
        "text": "Prototype the riskiest assumption at the lowest useful fidelity."
      }
    ],
    "SHOULD": [
      {
        "id": "UX-003.S1",
        "text": "Reframe when evidence invalidates the problem statement."
      },
      {
        "id": "UX-003.S2",
        "text": "Define in advance what experiment result changes the design."
      }
    ],
    "AVOID": [
      {
        "id": "UX-003.A1",
        "text": "Run workshops without testable outputs."
      },
      {
        "id": "UX-003.A2",
        "text": "Equate idea volume with validated innovation."
      }
    ],
    "DECIDE": [
      {
        "situation": "Problem uncertain",
        "decision": "Research and reframe"
      },
      {
        "situation": "Solution uncertain",
        "decision": "Prototype alternatives"
      },
      {
        "situation": "Feasibility uncertain",
        "decision": "Run technical spike"
      }
    ],
    "STATES": [
      "Empathize",
      "Define",
      "Ideate",
      "Prototype",
      "Test",
      "Reframe"
    ],
    "FAILURE_MODES": [
      "Workshops that produce no testable output consume time without reducing uncertainty.",
      "Idea volume is not validation; concepts must be prototyped and tested.",
      "Skipping reframe after invalidating evidence locks the team into the wrong problem."
    ],
    "CHECK": []
  },
