  ],
  "summary": "Double Diamond separates discovering the right problem from developing the right response, with divergence and evidence-based convergence.",
  "sections": {
    "MUST": [
      {
        "id": "UX-004.M1",
        "text": "Keep problem discovery separate from solution selection."
      },
      {
        "id": "UX-004.M2",
        "text": "Record evidence and criteria at each convergence point."
      },
      {
        "id": "UX-004.M3",
        "text": "Reopen discovery if testing invalidates the problem statement."
      }
    ],
    "SHOULD": [
      {
        "id": "UX-004.S1",
        "text": "Use research synthesis, defined problem, tested concepts and validated direction as transition artifacts."
      }
    ],
    "AVOID": [
      {
        "id": "UX-004.A1",
        "text": "Treat phases as a rigid waterfall."
      },
      {
        "id": "UX-004.A2",
        "text": "Use the diagram instead of research or testing."
      }
    ],
    "DECIDE": [
      {
        "situation": "Problem space uncertain",
        "decision": "Discover broadly"
      },
      {
        "situation": "Problem clear, solution unclear",
        "decision": "Develop alternatives"
      },
      {
        "situation": "Evidence conflicts",
        "decision": "Return to discovery"
      }
    ],
    "STATES": [
      "Discover",
      "Define",
      "Develop",
      "Deliver",
      "Feedback loop"
    ],
    "FAILURE_MODES": [
      "Treating the four phases as a rigid waterfall prevents returning to discovery.",
      "Using the diagram as a substitute for research or testing skips evidence.",
      "Converging without recorded criteria makes the chosen direction indefensible."
    ],
    "CHECK": []
  },
