generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- Knowledge content -----------------------------------------------------

model Doc {
  id        String   @id // "CMP-001"
  domain    String
  group     String?
  tags      String[]
  stages    String[]
  priority  String   @default("core")
  appliesTo String[]
  sourceUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions DocVersion[]

  @@index([domain])
  @@index([priority])
}

// Every edit creates a row. Immutable history; latest reviewed row is publishable.
model DocVersion {
  id          String   @id @default(cuid())
  docId       String
  doc         Doc      @relation(fields: [docId], references: [id], onDelete: Cascade)
  rev         Int
  title       String
  summary     String
  body        String // Markdown: Summary / MUST / SHOULD / AVOID / DECIDE / STATES / CHECK
  status      String // draft | reviewed | published | deprecated
  frontMatter Json
  contentHash String
  author      String   @default("seed")
  createdAt   DateTime @default(now())

  @@unique([docId, rev])
  @@index([docId, status])
}

// Immutable snapshot. Publishing flips isActive; rollback flips it back.
model Release {
  id        String   @id @default(cuid())
  version   String   @unique // "1.4.0"
  notes     String   @default("")
  snapshot  Json // { docs: { id: { rev, hash } }, packs: {...}, routes: [...] }
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isActive])
}

model Pack {
  stage        String   @id
  docIds       String[]
  budgetTokens Int      @default(6000)
  includeCore  Boolean  @default(true)
  updatedAt    DateTime @updatedAt
}

model Route {
  id        String   @id @default(cuid())
  match     String[]
  add       String[]
  createdAt DateTime @default(now())

  @@index([match], type: Gin)
}

// --- Access and observability ---------------------------------------------

enum Role {
  MEMBER
  ADMIN
}

// One row per GitHub identity that has signed in.
model User {
  id          String    @id @default(cuid())
  githubId    String    @unique
  login       String    @unique
  email       String?
  name        String?
  avatarUrl   String?
  role        Role      @default(MEMBER)
  mfaSecret   String?
  mfaEnabled  Boolean   @default(false)
  suspendedAt DateTime?
  createdAt   DateTime  @default(now())
  lastLoginAt DateTime?

  apiKeys    ApiKey[]
  auditLogs  AuditLog[]
  oauthCodes OAuthAuthorizationCode[]
  oauthGrants OAuthGrant[]
  oauthTokens OAuthAccessToken[]

  @@index([role])
}

model ApiKey {
  id            String    @id @default(cuid())
  name          String // "claude-code-laptop"
  hashedKey     String    @unique
  prefix        String    @default("") // "uxkb_AbCdEf" for display only
  scopes        String[]  @default(["mcp:read"])
  pinnedVersion String? // null = follow the active release
  rateLimit     Int       @default(60) // requests per minute
  expiresAt     DateTime?
  revokedAt     DateTime?
  revokedReason String?
  createdAt     DateTime  @default(now())
  lastUsedAt    DateTime?
  lastUsedIp    String?

  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  sessions Session[]
  usage    UsageLog[]
  oauthGrant OAuthGrant?

  @@index([ownerId, revokedAt])
}

model Session {
  id         String   @id @default(cuid())
  apiKeyId   String
  apiKey     ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  feature    String
  kbVersion  String
  fetched    String[] // doc IDs actually retrieved
  startedAt  DateTime @default(now())

  compliance Compliance[]
  usage      UsageLog[]

  @@index([apiKeyId, startedAt])
}

model UsageLog {
  id        String   @id @default(cuid())
  apiKeyId  String
  apiKey    ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  sessionId String?
  session   Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  tool      String
  args      Json
  latencyMs Int
  ok        Boolean
  createdAt DateTime @default(now())

  @@index([apiKeyId, createdAt])
  @@index([tool, createdAt])
}

model Compliance {
  id        String   @id @default(cuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  citedIds  String[]
  unfetched String[]
  unknown   String[]
  createdAt DateTime @default(now())

  @@index([sessionId])
}

model KbGap {
  id        String   @id @default(cuid())
  topic     String   @unique
  context   String
  count     Int      @default(1)
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resolved, count])
}

model AuditLog {
  id          String   @id @default(cuid())
  actor       String // human-readable label, e.g. "github:Vinoth82003"
  actorUserId String?
  actorUser   User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String
  target      String
  metadata    Json?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([actorUserId])
  @@index([action, createdAt])
}

model RateLimitWindow {
  keyId       String // api key id, or "ip:<hash>" for anonymous callers
  kind        String   @default("minute") // minute | day | hour
  windowStart DateTime
  count       Int      @default(0)
  @@id([keyId, kind, windowStart])
  @@index([windowStart])
}

// --- MCP OAuth 2.1 ---------------------------------------------------------
//
// The MCP endpoint accepts two credential types: long-lived API keys
// ("uxkb_") and short-lived OAuth access tokens ("uxko_"). OAuth clients are
// registered dynamically (RFC 7591); each client/user pair is backed by a
// single hidden API key so sessions, usage, and rate limits keep working.

model OAuthClient {
  id                      String   @id @default(cuid())
  clientId                String   @unique
  clientSecretHash        String?
  name                    String
  redirectUris            String[]
  grantTypes              String[] @default(["authorization_code", "refresh_token"])
  responseTypes           String[] @default(["code"])
  scopes                  String[] @default(["mcp:read"])
  tokenEndpointAuthMethod String   @default("none") // none | client_secret_post | client_secret_basic
  createdByIp             String?
  createdAt               DateTime @default(now())
  lastUsedAt              DateTime?

  codes  OAuthAuthorizationCode[]
  grants OAuthGrant[]
  tokens OAuthAccessToken[]

  @@index([createdByIp, createdAt])
}

model OAuthAuthorizationCode {
  id                  String   @id @default(cuid())
  codeHash            String   @unique
  clientId            String
  client              OAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  redirectUri         String
  scopes              String[]
  codeChallenge       String
  codeChallengeMethod String   @default("S256")
  resource            String?
  expiresAt           DateTime
  usedAt              DateTime?
  createdAt           DateTime @default(now())

  @@index([expiresAt])
  @@index([userId])
}

model OAuthGrant {
  id        String   @id @default(cuid())
  clientId  String
  client    OAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKeyId  String   @unique
  apiKey    ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  scopes    String[] @default(["mcp:read"])
  createdAt DateTime @default(now())
  revokedAt DateTime?

  tokens OAuthAccessToken[]

  @@unique([clientId, userId])
  @@index([userId])
}

model OAuthAccessToken {
  id               String   @id @default(cuid())
  accessTokenHash  String   @unique
  refreshTokenHash String   @unique
  grantId          String
  grant            OAuthGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)
  clientId         String
  client           OAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scopes           String[]
  expiresAt        DateTime
  refreshExpiresAt DateTime
  revokedAt        DateTime?
  createdAt        DateTime @default(now())
  lastUsedAt       DateTime?

  @@index([grantId, createdAt])
  @@index([expiresAt])
  @@index([userId])
}
